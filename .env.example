# Copy this file to `.env` in the repo root (or into backend/.env) and fill in real values.
# Never commit the real `.env` file.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- ASR: Deepgram (default) ---
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# Streaming options (advanced). Endpoint override is mainly for testing/proxies.
# DEEPGRAM_ENDPOINT=wss://api.deepgram.com/v1/listen
# DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_ENDPOINTING_MS=600
# DEEPGRAM_UTTERANCE_END_MS=900
# DEEPGRAM_PUNCTUATE=true
# DEEPGRAM_SMART_FORMAT=true
# DEEPGRAM_LANGUAGE_DETECTION=true
# DEEPGRAM_CONNECT_TIMEOUT_SEC=10
# DEEPGRAM_SEND_TIMEOUT_SEC=5
# DEEPGRAM_RECONNECT_MAX_ATTEMPTS=3
# DEEPGRAM_RECONNECT_BASE_DELAY_MS=500
# DEEPGRAM_AUDIO_BUFFER_SECONDS=2

# --- Translation: hybrid (cloud default, NLLB-200 fallback) ---
# hybrid = try cloud first, fall back to NLLB-200 offline on failure.
# cloud / nllb pin a single path instead.
TRANSLATION_PROVIDER=hybrid
CLOUD_TRANSLATION_API_KEY=
CLOUD_TRANSLATION_PROVIDER_NAME=google
# Google Cloud Translation v2 REST endpoint (override mainly for tests/proxies).
# CLOUD_TRANSLATION_ENDPOINT=https://translation.googleapis.com/language/translate/v2
# CLOUD_TRANSLATION_TIMEOUT_SEC=5
# Extra languages for the central registry, e.g.:
# TRANSLATION_EXTRA_LANGUAGES=[{"iso_code":"mr","display_name":"Marathi","nllb_code":"mar_Deva"}]
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
NLLB_DEVICE=cpu
# NLLB_MAX_LENGTH=128
# NLLB_NUM_BEAMS=4

# --- LLM: async post-processing / refinement (never on the hot path) ---
# Refines finalized transcripts in the background (punctuation, casing, obvious
# ASR formatting errors) WITHOUT ever delaying the live transcript/translation.
ENABLE_LLM_REFINEMENT=true
# LLM_REFINEMENT_ENABLED=true   # (older alias for the same flag)
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SEC=20              # abandon a single refinement call after this long
LLM_CONTEXT_SEGMENTS=4          # rolling window of prior finalized segments
# Skip the LLM round-trip entirely when the finalized transcript already looks
# clean (punctuation, casing, no duplicate words). Set false to always refine.
LLM_SKIP_WHEN_CLEAN=true
# LLM_ENDPOINT=                 # override for proxies/tests

# --- Silence / sentence-boundary tuning (client-side Silero VAD feeds these) ---
SILENCE_FINALIZE_MS=700
SILENCE_MIN_SPEECH_MS=150

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=linear16
MAX_WS_MESSAGE_BYTES=1000000

# --- Frontend (Vite reads VITE_-prefixed vars from frontend/.env) ---
VITE_BACKEND_HOST=localhost:8000
VITE_BACKEND_USE_TLS=false
