# Copy this file to `.env` in the repo root (or into backend/.env) and fill in
# real values. Never commit the real `.env` file.
#
# The same file is loaded by docker compose (see docker-compose.yml /
# docker-compose.prod.yml). Values are read at container runtime, so changing
# them never requires a rebuild -- just `docker compose up -d` again.

# --- General ---
# ENVIRONMENT is the canonical name (APP_ENV is accepted as an alias).
ENVIRONMENT=development
LOG_LEVEL=INFO
# "console" = pretty dev logs, "json" = structured JSON lines (prod).
LOG_FORMAT=console
# JSON list of allowed browser origins for the REST API (CORS).
# Local dev: ["http://localhost:5173"]
# Production: ["https://app.example.com"]  (must not use "*" with credentials)
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
# Optional WebSocket Origin allowlist (cross-site WebSocket hijacking
# protection). Empty = allow any Origin (needed for the Electron file://
# client unless you list "file://"). Production example:
# WS_ALLOWED_ORIGINS=["https://app.example.com"]

# --- ASR: Deepgram (default) ---
ASR_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Streaming options (advanced). Endpoint override is mainly for testing/proxies.
# DEEPGRAM_ENDPOINT=wss://api.deepgram.com/v1/listen
# DEEPGRAM_INTERIM_RESULTS=true
DEEPGRAM_ENDPOINTING_MS=600
# DEEPGRAM_UTTERANCE_END_MS=900
# DEEPGRAM_PUNCTUATE=true
# DEEPGRAM_SMART_FORMAT=true
# DEEPGRAM_LANGUAGE_DETECTION=true
# DEEPGRAM_CONNECT_TIMEOUT_SEC=10
# DEEPGRAM_SEND_TIMEOUT_SEC=5
# DEEPGRAM_RECONNECT_MAX_ATTEMPTS=3
# DEEPGRAM_RECONNECT_BASE_DELAY_MS=500
# DEEPGRAM_AUDIO_BUFFER_SECONDS=2

# --- Translation: NLLB-200 (default) ---
# "nllb" (default) uses the NLLB-200 translation service.
# "hybrid" tries cloud first (needs TRANSLATION_API_KEY), falls back to NLLB.
# "cloud" pins cloud-only (needs TRANSLATION_API_KEY).
TRANSLATION_PROVIDER=nllb
# TRANSLATION_API_KEY is the canonical name (CLOUD_TRANSLATION_API_KEY is
# accepted as an alias). Google Cloud Translation v2 REST is used.
# Only needed for "cloud" or "hybrid" modes.
TRANSLATION_API_KEY=
CLOUD_TRANSLATION_PROVIDER_NAME=google
# Google Cloud Translation v2 REST endpoint (override mainly for tests/proxies).
# CLOUD_TRANSLATION_ENDPOINT=https://translation.googleapis.com/language/translate/v2
# CLOUD_TRANSLATION_TIMEOUT_SEC=5
# Extra languages for the central registry, e.g.:
# TRANSLATION_EXTRA_LANGUAGES=[{"iso_code":"mr","display_name":"Marathi","nllb_code":"mar_Deva"}]

# --- NLLB translation service ---
# Empty (default) = in-process NLLBTranslationProvider (requires the
# `offline` extra: `uv sync --extra offline`). This is what local dev uses.
# Docker compose sets this to http://nllb:8001 automatically for the
# containerized NLLB service (no offline extra needed).
NLLB_SERVICE_URL=
NLLB_SERVICE_TIMEOUT_SEC=30
# In-process settings (used when NLLB_SERVICE_URL is empty, and by the
# standalone nllb service container):
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
NLLB_DEVICE=cpu
# NLLB_MAX_LENGTH=128
# NLLB_NUM_BEAMS=4

# --- LLM: async post-processing / refinement (never on the hot path) ---
# Refines finalized transcripts in the background (punctuation, casing, obvious
# ASR formatting errors) WITHOUT ever delaying the live transcript/translation.
ENABLE_LLM_REFINEMENT=true
# LLM_REFINEMENT_ENABLED=true   # (older alias for the same flag)
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TIMEOUT_SEC=20              # abandon a single refinement call after this long
LLM_CONTEXT_SEGMENTS=4          # rolling window of prior finalized segments
# Skip the LLM round-trip entirely when the finalized transcript already looks
# clean (punctuation, casing, no duplicate words). Set false to always refine.
LLM_SKIP_WHEN_CLEAN=true
# LLM_ENDPOINT=                 # override for proxies/tests

# --- Silence / sentence-boundary tuning (client-side Silero VAD feeds these) ---
SILENCE_FINALIZE_MS=700
SILENCE_MIN_SPEECH_MS=150

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=linear16
MAX_WS_MESSAGE_BYTES=1000000

# --- Backend server (container) ---
# PORT=8000
# WORKERS=1        # keep 1: sessions are in-process (multi-worker needs sticky routing)

# --- Frontend container (nginx) ---
# Where the browser/Electron connects for the WebSocket (and API). Leave
# BACKEND_HOST empty to connect to the SAME origin that served the page (the
# nginx reverse proxy). Set it for a separate API domain, e.g.
#   BACKEND_HOST=api.example.com
#   BACKEND_USE_TLS=true
BACKEND_HOST=
BACKEND_USE_TLS=false

# --- NLLB service container (always starts with the stack) ---
# HF_HOME=/models          # model weights cache volume
# NLLB_WARM_START=true     # preload the model at startup
